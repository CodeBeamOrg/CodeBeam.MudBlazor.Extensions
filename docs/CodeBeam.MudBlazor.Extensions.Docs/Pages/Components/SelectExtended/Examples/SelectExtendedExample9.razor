@namespace MudExtensions.Docs.Examples

<MudGrid>
    <MudItem xs="12" sm="8">
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2">
                Both selects offer 1,000 options, but virtualization renders only the visible options.
                Values near the end of the collection are already selected.
            </MudText>

            <MudSelectExtended T="string"
                               Label="Single selection (1,000 items)"
                               ItemCollection="_items"
                               @bind-Value="_selectedValue"
                               Virtualize="true"
                               Clearable="_clearable" />

            <MudSelectExtended T="string"
                               Label="Multiple selection (1,000 items)"
                               ItemCollection="_items"
                               @bind-SelectedValues="_selectedValues"
                               Virtualize="true"
                               MultiSelection="true"
                               Clearable="_clearable" />

            <MudText Typo="Typo.caption">
                Selected items: @(string.Join(", ", _selectedValues ?? []))
            </MudText>
        </MudStack>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSwitchM3 @bind-Value="_clearable" Color="Color.Secondary" Label="Clearable" />
    </MudItem>
</MudGrid>

@code {
    private readonly string[] _items = Enumerable.Range(1, 1_000)
        .Select(index => $"Item {index:0000}")
        .ToArray();

    private string? _selectedValue = "Item 0950";
    private IEnumerable<string?> _selectedValues = ["Item 0005", "Item 0950"];
    private bool _clearable;
}
