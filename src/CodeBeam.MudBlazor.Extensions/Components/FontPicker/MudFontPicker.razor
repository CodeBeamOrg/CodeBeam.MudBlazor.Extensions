@namespace MudExtensions
@inherits MudComponentBase

<MudAutocomplete T="string"
                 @ref="_autocomplete"
                 Class="@Class"
                 Style="@InputStyle"
                 UserAttributes="@UserAttributes"
                 PopoverClass="@PopoverClass"
                 Label="@Label"
                 Value="@Font"
                 ValueChanged="@SetFontValue"
                 Variant="@Variant"
                 Margin="@Margin"
                 Dense="@Dense"
                 Required="@Required"
                 RequiredError="@RequiredError"
                 Placeholder="@Placeholder"
                 MaxItems="@MaxItems"
                 Disabled="@Disabled"
                 HelperText="@HelperText"
                 HelperTextOnFocus="@HelperTextOnFocus"
                 Counter="@Counter"
                 MaxLength="@MaxLength"
                 IconSize="@IconSize"
                 DebounceInterval="@DebounceInterval"
                 AutoFocus="@AutoFocus"
                 Adornment="@Adornment"
                 AdornmentAriaLabel="@AdornmentAriaLabel"
                 AdornmentColor="@AdornmentColor"
                 AdornmentIcon="@AdornmentIcon"
                 AdornmentText="@AdornmentText"
                 OnAdornmentClick="@OnAdornmentClick"
                 SelectOnActivation="@SelectOnActivation"
                 ResetValueOnEmptyText="@ResetValueOnEmptyText"
                 SearchFunc="@SearchFonts"
                 Clearable="@Clearable"
                 OnClearButtonClick="@ClearFont"
                 Error="@Error"
                 ErrorId="@ErrorId"
                 ErrorText="@ErrorText"
                 CoerceValue="false"
                 AnchorOrigin="@AnchorOrigin"
                 TransformOrigin="@TransformOrigin"
                 Underline="@Underline"
                 Immediate="@Immediate"
                 FullWidth="@FullWidth"
                 MinCharacters="@MinCharacters"
                 SelectValueOnTab="@SelectValueOnTab"
                 OnlyValidateIfDirty="@OnlyValidateIfDirty"
                 ReadOnly="@ReadOnly"
                 For="@For"
                 Validation="@Validation"
                 Strict="@Strict"
                 OpenOnFocus="@OpenOnFocus"
                 OuterClass="@OuterClass"
                 InputClass="@InputClass"
                 OnBlur="@OnBlur"
                 OnKeyDown="@OnKeyDown"
                 OnKeyUp="@OnKeyUp">
    <ItemTemplate Context="font">
        <MudText Style="@($"font-family:\"{font}\" !important")">
            <style>
                @ImportFontStyleText(font)
            </style>
            @font
        </MudText>
    </ItemTemplate>
</MudAutocomplete>
